{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japanese-song-practice",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/kuromoji-dict/tid_pos.dat.gz"
    ]
  },
  "observability": {
    "enabled": true
  }
}
